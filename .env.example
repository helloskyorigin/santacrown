# Copy the variable names into Vercel Project > Settings > Environment Variables.
# NEVER fill this file with real secrets or push a .env file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_CONFIGURE_IN_VERCEL_ONLY
DODO_PAYMENTS_API_KEY=CONFIGURE_IN_VERCEL_ONLY
DODO_PAYMENTS_WEBHOOK_KEY=whsec_CONFIGURE_IN_VERCEL_ONLY
DODO_PAYMENTS_PRODUCT_ID=pdt_CONFIGURE_IN_VERCEL_ONLY
DODO_PAYMENTS_ENVIRONMENT=test_mode
SANTACROWN_SITE_ORIGIN=https://santacrown.vercel.app
SANTACROWN_RATE_SALT=CONFIGURE_RANDOM_STRING_IN_VERCEL_ONLY
# Start disabled. Flip only after SQL migration, signed webhook tests and policy review.
SANTACROWN_CHECKOUT_ENABLED=false
DODO_PAYMENTS_APPROVED=false
SANTACROWN_LIVE_CONFIRMED=false
# Mandatory for live_mode only; test_mode remains available after Dodo approval.
SANTACROWN_COMMERCIAL_TERMS_READY=false
SANTACROWN_MERCHANT_LEGAL_NAME=
# Exact published event cutoff in ISO8601 UTC; the API closes real checkout after this.
SANTACROWN_EVENT_CUTOFF_AT=

